# Ignore poetry files
poetry.lock
# Ignore Python cache files
__pycache__/
*.py[cod]
# greenprompt/constants.py is a tracked source file and must NOT be ignored.
# Machine-specific values live in ~/.greenprompt/config.json (see setup.py).
# Stray constants.py files written by older versions into a working directory:
/constants.py
# Ignore DB files
*.sqlite3
*.db
# Ignore .log files
*.log
# Ignore dist folder
dist/
# Ignore ipynb files
*.ipynb
# Ignore .DS_Store files
.DS_Store